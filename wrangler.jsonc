{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Own names (ggwd*) so nothing collides with other projects in the same Cloudflare account.
  "name": "ggwd",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // `server-only` throws outside Next's react-server build, and the Workflow is bundled by Wrangler.
  "alias": { "server-only": "./src/lib/empty.ts" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ggwd",
      "database_id": "61d520c3-d6f1-4eb1-b0b4-40722c30f07b",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    {
      "name": "ggwd-analysis",
      "binding": "ANALYSIS_WORKFLOW",
      "class_name": "AnalysisWorkflow"
    }
  ],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "ggwd" }]
}
