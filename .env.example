# Copy to .env.local (local dev) or set as Worker secrets (Cloudflare).
NEBIUS_API_KEY=        # Nebius Token Factory: https://tokenfactory.nebius.com
TAVILY_API_KEY=        # Tavily: https://app.tavily.com
# JUDGE_CODE=          # if set, reports and game suggestions need ?code=<this> (the public demo); unset = open
# GGWD_MOCK=1        # preview the whole pipeline without keys (Steam data real, AI and web answers canned)
# Optional: pin exact Token Factory model ids if the defaults in src/lib/models.ts change.
# NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
